# Database password used by Docker Compose. Set it BEFORE the first start: PostgreSQL only reads it
# when the database is created. Use letters and digits only, e.g. from: openssl rand -hex 24
POSTGRES_PASSWORD=

# PostgreSQL connection for running the API and worker outside Docker (development).
# Docker Compose builds its own connection string from POSTGRES_PASSWORD.
DATABASE_URL=postgres://arclight:arclight@localhost:5432/arclight

# API server
PORT=8787
# Google Cloud API key with "PageSpeed Insights API" and "Places API (New)" enabled.
# Used by the API (prospect search) and the worker (speed checks, Places lookups, hunts).
GOOGLE_API_KEY=

# Anthropic API key, used to write outreach drafts (by the API, and by the worker for hunts with
# automatic drafting). Without it, drafting is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Or use Google Gemini for drafts and chat (used when ANTHROPIC_API_KEY is empty):
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Instagram Business Discovery (optional): follower counts and activity of businesses' Instagram
# accounts, read through your agency's own Instagram business account. See docs/instagram.md.
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Worker
# Audits that run in parallel
AUDIT_CONCURRENCY=3
# Country calling code for local phone numbers found on websites (62 = Indonesia)
DEFAULT_COUNTRY_CODE=62

# Dashboard → API (the dashboard is a client of the public API like any other website)
ARCLIGHT_API_URL=http://localhost:8787
# Create one with: pnpm api-key:create dashboard
ARCLIGHT_API_KEY=

# Dashboard sign-in (required). Use a long password.
DASHBOARD_PASSWORD=
# At least 32 random characters, e.g. from: openssl rand -hex 32
SESSION_SECRET=
