# PostgreSQL connection used by the API, worker and migrations
DATABASE_URL=postgres://jarvis:jarvis@localhost:5432/jarvis

# API server
PORT=8787
# Anthropic API key, used to write outreach drafts. Without it, drafting is disabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# Worker
# Google PageSpeed Insights API key (free). Without it, audits skip speed checks.
# Create one at https://console.cloud.google.com/ and enable "PageSpeed Insights API".
PAGESPEED_API_KEY=
# Audits that run in parallel
AUDIT_CONCURRENCY=3
# Country calling code for local phone numbers found on websites (62 = Indonesia)
DEFAULT_COUNTRY_CODE=62

# Dashboard → API (the dashboard is a client of the public API like any other website)
JARVIS_API_URL=http://localhost:8787
# Create one with: pnpm api-key:create dashboard
JARVIS_API_KEY=
