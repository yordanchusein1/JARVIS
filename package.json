{
  "name": "jarvis",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @jarvis/api dev",
    "dev:dashboard": "pnpm --filter @jarvis/dashboard dev",
    "db:generate": "pnpm --filter @jarvis/core db:generate",
    "db:migrate": "pnpm --filter @jarvis/core db:migrate",
    "api-key:create": "pnpm --filter @jarvis/api api-key:create",
    "sdk:generate": "pnpm --filter @jarvis/api openapi:export && pnpm --filter @jarvis/sdk generate",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --workspace-concurrency=1 test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
