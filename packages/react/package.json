{
  "name": "@arclighthq/react",
  "version": "0.2.1",
  "description": "React components and a server handler for embedding Arclight in any admin panel",
  "license": "MIT",
  "keywords": [
    "arclight",
    "react",
    "lead generation",
    "agency",
    "admin",
    "components"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yordanchusein1/arclight.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/yordanchusein1/arclight#readme",
  "bugs": "https://github.com/yordanchusein1/arclight/issues",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "typecheck": "tsc",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/styles.css dist/",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@arclighthq/sdk": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server.d.ts",
        "import": "./dist/server.js"
      },
      "./styles.css": "./dist/styles.css"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "sideEffects": [
    "*.css"
  ]
}
