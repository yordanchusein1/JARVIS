{
  "openapi": "3.1.0",
  "info": {
    "title": "Arclight API",
    "version": "0.1.0",
    "description": "HTTP API of the Arclight engine. Call it from your server with an API key; never expose the key to browsers.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key created with `pnpm api-key:create <name>`"
      }
    },
    "schemas": {
      "Business": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "enum": [
              "url",
              "csv",
              "places"
            ]
          },
          "placeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "websiteUrl": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://klinik.co.id/"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "replied",
              "meeting",
              "won",
              "lost"
            ]
          },
          "feedback": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "good",
              "bad",
              null
            ],
            "description": "A person rated this lead 👍 or 👎"
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Geometric mean of the latest need and capacity scores"
          },
          "latestAudit": {
            "$ref": "#/components/schemas/Audit"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "source",
          "placeId",
          "websiteUrl",
          "displayName",
          "status",
          "feedback",
          "priority",
          "latestAudit",
          "createdAt",
          "updatedAt"
        ]
      },
      "Audit": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "needScore": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "How much the business needs the agency (0–100)"
          },
          "capacityScore": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "How established the business is (0–100)"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "How the audit ran, e.g. skipped checks"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "needScore",
          "capacityScore",
          "error",
          "notes",
          "createdAt",
          "finishedAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Place": {
        "type": "object",
        "properties": {
          "placeId": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "address": {
            "type": [
              "string",
              "null"
            ]
          },
          "websiteUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "ratingCount": {
            "type": [
              "integer",
              "null"
            ]
          },
          "mapsUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "placeId",
          "name",
          "address",
          "websiteUrl",
          "phone",
          "rating",
          "ratingCount",
          "mapsUrl"
        ],
        "description": "Live data from Google Places. Google does not allow storing it, so it is never saved by Arclight."
      },
      "BusinessDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Business"
          },
          {
            "type": "object",
            "properties": {
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Signal"
                },
                "description": "Signals from the latest audit, strongest first"
              },
              "contacts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Contact"
                }
              },
              "drafts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Draft"
                },
                "description": "Latest draft per channel"
              },
              "doNotContact": {
                "type": "boolean",
                "description": "The website's domain is on the do-not-contact list"
              }
            },
            "required": [
              "signals",
              "contacts",
              "drafts",
              "doNotContact"
            ]
          }
        ]
      },
      "Signal": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "need",
              "capacity"
            ]
          },
          "key": {
            "type": "string",
            "example": "slow_mobile"
          },
          "points": {
            "type": "integer"
          },
          "evidence": {
            "type": "string",
            "example": "Google PageSpeed Insights rates the mobile performance 34/100."
          }
        },
        "required": [
          "axis",
          "key",
          "points",
          "evidence"
        ]
      },
      "Contact": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "whatsapp",
              "instagram",
              "facebook",
              "tiktok",
              "linkedin",
              "other"
            ]
          },
          "value": {
            "type": "string"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "value",
          "sourceUrl"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "email"
            ]
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Automatic checks to review before sending, e.g. an unsupported number"
          },
          "model": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "channel",
          "subject",
          "body",
          "warnings",
          "model",
          "createdAt"
        ]
      },
      "LeadStatus": {
        "type": "string",
        "enum": [
          "new",
          "contacted",
          "replied",
          "meeting",
          "won",
          "lost"
        ]
      },
      "AgencyProfile": {
        "type": "object",
        "properties": {
          "agencyName": {
            "type": "string",
            "maxLength": 200
          },
          "senderName": {
            "type": "string",
            "maxLength": 200
          },
          "services": {
            "type": "string",
            "maxLength": 2000,
            "description": "What the agency offers, in plain words"
          },
          "tone": {
            "type": "string",
            "maxLength": 200,
            "example": "friendly and professional"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "example": "id",
            "description": "BCP 47 tag"
          }
        },
        "required": [
          "agencyName",
          "senderName",
          "services",
          "tone",
          "language"
        ]
      },
      "DoNotContact": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "domain",
              "email",
              "phone"
            ]
          },
          "value": {
            "type": "string"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "kind",
          "value",
          "reason",
          "createdAt"
        ]
      },
      "SignalInsight": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "axis": {
            "type": "string",
            "enum": [
              "need",
              "capacity"
            ]
          },
          "defaultPoints": {
            "type": "integer"
          },
          "points": {
            "type": "integer"
          },
          "leads": {
            "type": "integer"
          },
          "good": {
            "type": "integer"
          },
          "bad": {
            "type": "integer"
          }
        },
        "required": [
          "key",
          "axis",
          "defaultPoints",
          "points",
          "leads",
          "good",
          "bad"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "The API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/businesses": {
      "get": {
        "operationId": "listBusinesses",
        "summary": "List tracked businesses, highest priority first",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Tracked businesses with their latest audit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Business"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "trackBusinesses",
        "summary": "Start tracking businesses from website addresses",
        "description": "New businesses are queued for an audit. Invalid addresses are reported in `skipped`, and websites that are already tracked are returned without being duplicated.",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "websites": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "minItems": 1,
                    "maxItems": 100,
                    "example": [
                      "klinik.co.id",
                      "https://www.sekolah-contoh.sch.id"
                    ]
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "url",
                      "csv"
                    ],
                    "default": "url",
                    "description": "Where the list came from"
                  }
                },
                "required": [
                  "websites"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Businesses for the given websites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Business"
                      }
                    },
                    "created": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "input",
                          "reason"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data",
                    "created",
                    "skipped"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/import": {
      "post": {
        "operationId": "importBusinessesCsv",
        "summary": "Start tracking the websites listed in a CSV export",
        "description": "Uses the column headed website, url or domain, or else every cell that looks like a website. At most 1000 websites per import.",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "csv": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000000
                  }
                },
                "required": [
                  "csv"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tracked businesses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Business"
                      }
                    },
                    "created": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "input",
                          "reason"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data",
                    "created",
                    "skipped"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "No websites found, or too many",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/places": {
      "post": {
        "operationId": "trackPlaces",
        "summary": "Start tracking businesses picked from a Google Places search",
        "description": "Only the Google place ID is stored. New businesses are queued for an audit.",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "placeIds": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 512
                    },
                    "minItems": 1,
                    "maxItems": 20
                  }
                },
                "required": [
                  "placeIds"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The tracked businesses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Business"
                      }
                    },
                    "created": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "input",
                          "reason"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data",
                    "created",
                    "skipped"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/{id}/place": {
      "get": {
        "operationId": "getBusinessPlace",
        "summary": "Live Google Places details of a business added from a Places search",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Live place details (not stored)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Place"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Google Places failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Google Places is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/{id}": {
      "get": {
        "operationId": "getBusiness",
        "summary": "Get one business with the evidence and contacts from its latest audit",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateBusiness",
        "summary": "Update a lead, e.g. move it through the pipeline",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/LeadStatus"
                  },
                  "feedback": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "enum": [
                      "good",
                      "bad",
                      null
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Business"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
