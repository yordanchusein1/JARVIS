{
  "openapi": "3.1.0",
  "info": {
    "title": "JARVIS API",
    "version": "0.1.0",
    "description": "HTTP API of the JARVIS engine. Call it from your server with an API key; never expose the key to browsers.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    }
  },
  "servers": [
    {
      "url": "/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API key created with `pnpm api-key:create <name>`"
      }
    },
    "schemas": {
      "Business": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "enum": [
              "url",
              "csv",
              "places"
            ]
          },
          "placeId": {
            "type": [
              "string",
              "null"
            ]
          },
          "websiteUrl": {
            "type": [
              "string",
              "null"
            ],
            "example": "https://klinik.co.id/"
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "contacted",
              "replied",
              "meeting",
              "won",
              "lost"
            ]
          },
          "priority": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "Geometric mean of the latest need and capacity scores"
          },
          "latestAudit": {
            "$ref": "#/components/schemas/Audit"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "source",
          "placeId",
          "websiteUrl",
          "displayName",
          "status",
          "priority",
          "latestAudit",
          "createdAt",
          "updatedAt"
        ]
      },
      "Audit": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "succeeded",
              "failed"
            ]
          },
          "needScore": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "How much the business needs the agency (0–100)"
          },
          "capacityScore": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0,
            "maximum": 100,
            "description": "How established the business is (0–100)"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "How the audit ran, e.g. skipped checks"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "finishedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "needScore",
          "capacityScore",
          "error",
          "notes",
          "createdAt",
          "finishedAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "BusinessDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Business"
          },
          {
            "type": "object",
            "properties": {
              "signals": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Signal"
                },
                "description": "Signals from the latest audit, strongest first"
              },
              "contacts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Contact"
                }
              },
              "drafts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Draft"
                },
                "description": "Latest draft per channel"
              }
            },
            "required": [
              "signals",
              "contacts",
              "drafts"
            ]
          }
        ]
      },
      "Signal": {
        "type": "object",
        "properties": {
          "axis": {
            "type": "string",
            "enum": [
              "need",
              "capacity"
            ]
          },
          "key": {
            "type": "string",
            "example": "slow_mobile"
          },
          "points": {
            "type": "integer"
          },
          "evidence": {
            "type": "string",
            "example": "Google PageSpeed Insights rates the mobile performance 34/100."
          }
        },
        "required": [
          "axis",
          "key",
          "points",
          "evidence"
        ]
      },
      "Contact": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "email",
              "phone",
              "whatsapp",
              "instagram",
              "facebook",
              "tiktok",
              "linkedin",
              "other"
            ]
          },
          "value": {
            "type": "string"
          },
          "sourceUrl": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "kind",
          "value",
          "sourceUrl"
        ]
      },
      "Draft": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "channel": {
            "type": "string",
            "enum": [
              "whatsapp",
              "email"
            ]
          },
          "subject": {
            "type": [
              "string",
              "null"
            ]
          },
          "body": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Automatic checks to review before sending, e.g. an unsupported number"
          },
          "model": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "channel",
          "subject",
          "body",
          "warnings",
          "model",
          "createdAt"
        ]
      },
      "LeadStatus": {
        "type": "string",
        "enum": [
          "new",
          "contacted",
          "replied",
          "meeting",
          "won",
          "lost"
        ]
      },
      "AgencyProfile": {
        "type": "object",
        "properties": {
          "agencyName": {
            "type": "string",
            "maxLength": 200
          },
          "senderName": {
            "type": "string",
            "maxLength": 200
          },
          "services": {
            "type": "string",
            "maxLength": 2000,
            "description": "What the agency offers, in plain words"
          },
          "tone": {
            "type": "string",
            "maxLength": 200,
            "example": "friendly and professional"
          },
          "language": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35,
            "example": "id",
            "description": "BCP 47 tag"
          }
        },
        "required": [
          "agencyName",
          "senderName",
          "services",
          "tone",
          "language"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check",
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "The API is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/businesses": {
      "get": {
        "operationId": "listBusinesses",
        "summary": "List tracked businesses, highest priority first",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Tracked businesses with their latest audit",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Business"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "trackBusinesses",
        "summary": "Start tracking businesses from website addresses",
        "description": "New businesses are queued for an audit. Invalid addresses are reported in `skipped`, and websites that are already tracked are returned without being duplicated.",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "websites": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "maxLength": 2048
                    },
                    "minItems": 1,
                    "maxItems": 100,
                    "example": [
                      "klinik.co.id",
                      "https://www.sekolah-contoh.sch.id"
                    ]
                  }
                },
                "required": [
                  "websites"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Businesses for the given websites",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Business"
                      }
                    },
                    "created": {
                      "type": "integer"
                    },
                    "skipped": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "input": {
                            "type": "string"
                          },
                          "reason": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "input",
                          "reason"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data",
                    "created",
                    "skipped"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/{id}": {
      "get": {
        "operationId": "getBusiness",
        "summary": "Get one business with the evidence and contacts from its latest audit",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BusinessDetail"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateBusiness",
        "summary": "Update a lead, e.g. move it through the pipeline",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "$ref": "#/components/schemas/LeadStatus"
                  }
                },
                "required": [
                  "status"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated business",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Business"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/{id}/audits": {
      "post": {
        "operationId": "auditBusiness",
        "summary": "Queue a new audit of the business",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "202": {
            "description": "The audit was queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Audit"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/businesses/{id}/drafts": {
      "post": {
        "operationId": "draftMessages",
        "summary": "Write WhatsApp and email drafts from the latest audit",
        "description": "Drafts cite only facts from the audit. JARVIS never sends them; a person reviews and sends each message.",
        "tags": [
          "Businesses"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "201": {
            "description": "The new drafts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Draft"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "No business with this id",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Not ready: the agency profile is incomplete or the audit has not succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "The language model failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "No language model is configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agency-profile": {
      "get": {
        "operationId": "getAgencyProfile",
        "summary": "Get the agency's profile, used to write outreach in its name",
        "tags": [
          "Agency"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "The profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgencyProfile"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "operationId": "updateAgencyProfile",
        "summary": "Update the agency's profile",
        "tags": [
          "Agency"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "agencyName": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "senderName": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "services": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "What the agency offers, in plain words"
                  },
                  "tone": {
                    "type": "string",
                    "maxLength": 200,
                    "example": "friendly and professional"
                  },
                  "language": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 35,
                    "example": "id",
                    "description": "BCP 47 tag"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated profile",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgencyProfile"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
