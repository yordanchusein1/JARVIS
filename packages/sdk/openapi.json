    "/places/search": {
      "get": {
        "operationId": "searchPlaces",
        "summary": "Search Google Places for prospects, e.g. \"klinik gigi Surabaya\"",
        "description": "Results come live from Google and are not stored. `businessId` is set when a result is already tracked.",
        "tags": [
          "Places"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 2,
              "maxLength": 200
            },
            "required": true,
            "name": "q",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Matching places",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "allOf": [
                          {
                            "$ref": "#/components/schemas/Place"
                          },
                          {
                            "type": "object",
                            "properties": {
                              "businessId": {
                                "type": [
                                  "string",
                                  "null"
                                ],
                                "format": "uuid"
                              }
                            },
                            "required": [
                              "businessId"
                            ]
                          }
                        ],
                        "description": "Live data from Google Places. Google does not allow storing it, so it is never saved by Arclight."
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Google Places failed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Google Places is not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
